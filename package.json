{
  "name": "suan-tiam-khuen",
  "version": "1.0.1",
  "description": "สวนเที่ยงคืน - เกมสยองขวัญ 3D",
  "author": "สวนเที่ยงคืน",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis",
    "publish": "electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "build": {
    "appId": "th.suantiamkhuen.game",
    "productName": "สวนเที่ยงคืน",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "สวนเที่ยงคืน.html",
      "package.json",
      "vendor/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "สวนเที่ยงคืน",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sixninerealstar-collab",
        "repo": "suan-tiam-khuen-updates"
      }
    ]
  },
  "allowScripts": {
    "electron@39.8.10": true
  }
}
